# Visual Listing Guardian — Environment Variables
#
# Copy to .env and fill in values. Shopify CLI populates SHOPIFY_* during `shopify app dev`.

# Required for vision analysis (free: https://console.groq.com)
GROQ_API_KEY=

# Optional: second Groq key — part of the rotation pool
# GROQ_API_KEY_FALLBACK=

# Optional: extra Groq keys (comma-separated). All keys round-robin so TPD
# is shared; a 429 cools that key and the next call continues on another.
# GROQ_API_KEYS=

# Optional: choose vision backends (default primary=groq, fallback=openrouter when keyed)
# VISION_PRIMARY_PROVIDER=groq
# VISION_FALLBACK_PROVIDER=openrouter
# VISION_FALLBACK_PROVIDER=none

# Optional backup if Groq is unavailable (free: https://openrouter.ai/settings/keys)
# OPENROUTER_API_KEY=

# Populated by Shopify CLI — do not set manually unless linking an existing app
# Do NOT hardcode *.trycloudflare.com URLs (they expire and break DNS for testers).
# Use: npm run dev  (fresh Cloudflare tunnel each run; required because this app has webhooks)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# SCOPES=read_products,write_products
# Optional: public JPG/PNG URL used for “Attach black wallet demo image”
# Prefer a direct image link. App downloads it and staged-uploads to Shopify
# (Shopify often cannot fetch Unsplash itself).
# DEMO_BLACK_WALLET_IMAGE_URL=https://example.com/black-wallet.jpg
